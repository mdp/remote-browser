# Address to publish VNC and MCP on.
# 127.0.0.1 = local only. Use a Tailscale/LAN address for remote access;
# 0.0.0.0 exposes the ports on every interface (only behind a firewall).
BROWSER_BIND_IP=127.0.0.1

# Persistent Chrome/VNC state. Keep outside this repository.
BROWSER_DATA_DIR=/home/youruser/.local/share/kasm-browser
KASM_PORT=6901
VNC_PASSWORD=

BROWSER_MCP_PORT=8931
# Optional full MCP endpoint, used by the helper scripts. Defaults to
# http://<BROWSER_BIND_IP>:<BROWSER_MCP_PORT>/mcp.
BROWSER_MCP_URL=
# Docker-only CDP endpoint. Never publish 9222 or 9223 on the host.
BROWSER_CDP_URL=http://chrome:9223

# Separate agent-browser metadata, not the Chrome profile.
BROWSER_AGENT_DATA_DIR=/home/youruser/.local/share/browser-agent
BROWSER_AGENT_SESSION=browser
BROWSER_AGENT_NAMESPACE=browser-agent

LOCAL_UID=1000
LOCAL_GID=1000
# Generate with: openssl rand -hex 32
BROWSER_MCP_API_KEY=

# Optional: only for scripts/connect-openwebui.ts.
OPENWEBUI_URL=
OPENWEBUI_API_KEY=
