# Copy to .env and set these machine-local values. Never commit .env.

# Host's Tailscale IPv4 address. The UI binds only to this and localhost.
TAILSCALE_IP=100.64.0.1

# Required KasmVNC password; replace with a long unique value.
VNC_PASSWORD=replace-with-a-long-random-password

# Keep browser state outside Syncthing and outside the public source repo.
# Relative paths are resolved from this directory; an absolute path is ideal.
BROWSER_DATA_DIR=./data

# Host ports; CDP is localhost-only and has no authentication.
KASM_HTTP_PORT=6901
KASM_HTTPS_PORT=6902
CDP_HOST_PORT=9222
